# The API. Locally you can point at production; there is one database.
AMS_API_URL=https://api.amsaccess.com

# Authenticates *this app* to ams-api. Fetch the real value with:
#   aws ssm get-parameter --region ap-south-1 \
#     --name /ams/prod/internal_api_secret --with-decryption \
#     --query Parameter.Value --output text
AMS_INTERNAL_API_SECRET=

# Cognito, for staff sign-in. Participants do not use it — they get
# contest-scoped credentials issued by staff.
AMS_AWS_REGION=ap-south-1
AMS_COGNITO_USER_POOL_ID=ap-south-1_CDkXGuE6k
AMS_COGNITO_CLIENT_ID=qe8r1vvo7ih0ug750uakdmgkk

# The `ams-portal` IAM user: six Cognito actions on one pool, nothing else.
#   /ams/prod/vercel_aws_access_key_id
#   /ams/prod/vercel_aws_secret_access_key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# NEVER set this outside local development. It bypasses authentication
# entirely, standing in as whichever subject you name.
# AMS_DEV_SUBJECT=
